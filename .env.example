# Windows native PostgreSQL/PostGIS. URL-encode special characters in credentials.
POSTGRES_DB=una_puno_360
POSTGRES_USER=una_user
POSTGRES_PASSWORD=replace_with_your_existing_local_postgres_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_MAINTENANCE_DB=postgres
DATABASE_URL=postgresql://una_user:replace_with_your_existing_local_postgres_password@127.0.0.1:5432/una_puno_360

APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
# For a physical Android device, use the Windows LAN IP instead of localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WEB_ORIGIN=http://localhost:3000

AUTH_LOCAL_ENABLED=true
AUTH_ALLOW_REGISTRATION=true
AUTH_DEV_EXPOSE_TOKENS=true
AUTH_JWT_SECRET=replace_with_at_least_48_random_characters_before_starting
COMMUNITY_JWT_SECRET=replace_with_at_least_48_random_characters_before_starting
TRANSPORT_BRIDGE_TOKEN=replace_with_a_private_bridge_token
TRANSPORT_WEBHOOK_SECRET=replace_with_a_private_webhook_secret
OVERPASS_USER_AGENT=UNAPuno360-MVP/0.8 (configure-contact)
