# Local development values only. Change secrets before any shared deployment.
POSTGRES_DB=una_hub
POSTGRES_USER=una_user
POSTGRES_PASSWORD=change_this_password_before_deploying
DATABASE_URL=postgresql://una_user:change_this_password_before_deploying@db:5432/una_hub
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_USER_AGENT=UNADataHubResearch/0.2 (contact: replace-with-real-email@example.org)

# SOLO LOCAL. No usar cuentas de demo en producción.
APP_ENV=development
COMMUNITY_JWT_SECRET=replace_me_with_at_least_32_random_characters

# v0.5: local accounts (NOT institutional identity). Use an independent secret.
AUTH_JWT_SECRET=replace_with_an_independent_64_char_random_secret
AUTH_LOCAL_ENABLED=true
AUTH_ALLOW_REGISTRATION=true
# Development ONLY. Exposes verification/reset tokens in responses for offline testing.
AUTH_DEV_EXPOSE_TOKENS=false

# Server-to-server ingest only; generate independent high-entropy secrets for both.
TRANSPORT_BRIDGE_TOKEN=CHANGE_TO_RANDOM_64_CHAR_HEX_TOKEN
TRANSPORT_WEBHOOK_SECRET=CHANGE_TO_ANOTHER_RANDOM_64_CHAR_HEX_TOKEN
# The following only apply to optional polling bridge.
TRANSPORT_PROVIDER=kuntur
TRANSPORT_PROVIDER_URL=
TRANSPORT_PROVIDER_TOKEN=
TRANSPORT_ALLOWED_HOSTS=
TRANSPORT_TENANT=una
TRANSPORT_HUB_URL=http://127.0.0.1:8000/transport/internal/ingest
